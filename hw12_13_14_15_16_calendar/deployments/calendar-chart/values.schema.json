{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "images",
    "replicas",
    "resources",
    "service",
    "ingress",
    "config",
    "connections",
    "postgres",
    "rabbitmq",
    "tests"
  ],
  "properties": {
    "images": {
      "type": "object",
      "required": [
        "api",
        "scheduler",
        "sender",
        "integration"
      ],
      "properties": {
        "api": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        },
        "scheduler": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        },
        "sender": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        },
        "integration": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        }
      }
    },
    "replicas": {
      "type": "object",
      "required": [
        "api",
        "scheduler",
        "sender"
      ],
      "properties": {
        "api": {
          "type": "integer",
          "minimum": 1
        },
        "scheduler": {
          "type": "integer",
          "minimum": 1
        },
        "sender": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "grpcPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "logLevel": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "queue": {
          "type": "string",
          "minLength": 1
        },
        "schedulerBatchSize": {
          "type": "integer",
          "minimum": 1
        },
        "rabbitmqPrefetch": {
          "type": "integer",
          "minimum": 1
        },
        "schedulerInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "schedulerTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "rabbitmqTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        }
      }
    },
    "connections": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "databaseDSN": {
          "type": "string"
        },
        "rabbitmqURL": {
          "type": "string"
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "storage",
        "resources",
        "user",
        "password",
        "database"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "user": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1
        }
      }
    },
    "rabbitmq": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "storage",
        "resources",
        "user",
        "password"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "user": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1
        }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiURL": {
          "type": "string"
        }
      }
    }
  }
}
